# The public demo is the default when these variables are omitted.
VITE_PORTAL_MODE=demo

# Switch to live only after the Pages Function, Apps Script, and OAuth are configured.
# VITE_PORTAL_MODE=live
# VITE_GOOGLE_CLIENT_ID=YOUR_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com
# In Cloudflare Pages Functions also configure GOOGLE_CLIENT_ID with the same
# public value, and APP_ORIGIN with the exact deployed https:// site origin.
# No VITE_API_BASE_URL is required on Cloudflare Pages: /v1/* is same-origin.
# Keep APPS_SCRIPT_URL, BRIDGE_SECRET, and optional SESSION_SIGNING_SECRET in
# encrypted Cloudflare Pages secrets. These are NEVER VITE_ environment values.
# Optional D1: bind a Cloudflare D1 database as DB and set the encrypted
# D1_SYNC_SECRET in Pages Functions (and the same Script Property in Apps Script).
# Set D1_ENABLED=true ONLY in the server-side Pages settings after first sync;
# do not add this or any D1 credentials as a VITE_ build variable.
